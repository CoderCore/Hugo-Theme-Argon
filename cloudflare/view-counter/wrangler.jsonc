{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "argon-view-counter",
  "main": "worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-09-11",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "argon-views",
      "database_id": "c9681f5e-9811-419c-aeb9-68024d655753"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://fufu.blog,https://www.fufu.blog,https://jiang068.github.io",
    "COMMENTS_ALLOW_GUESTS": "false"
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "9101",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "COMMENT_RATE_LIMITER",
      "namespace_id": "9102",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ]
}
